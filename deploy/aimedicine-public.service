[Unit]
Description=AIMedicine public demonstration
After=network.target

[Service]
WorkingDirectory=%h/Desktop/MAGA/AIMedicine
Environment=AIMEDICINE_PUBLIC_DEMO=1
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Desktop/MAGA/AIMedicine/.venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8502 --server.headless true --browser.gatherUsageStats false --client.toolbarMode viewer
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
